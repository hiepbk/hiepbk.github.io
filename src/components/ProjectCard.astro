---
import type { CollectionEntry } from 'astro:content';

interface Props { project: CollectionEntry<'projects'> }
const { project } = Astro.props;
const p = project.data;
---
<a class="card" href={`/projects/${project.id}/`} data-category={p.category}>
  <div class="card-media"><img src={p.image} alt={p.title} loading="lazy" /></div>
  <div class="card-body">
    <span class="tag">{p.tag}</span>
    <h3>{p.title}</h3>
    {p.description && <p>{p.description}</p>}
    {p.points.length > 0 && <ul>{p.points.map((pt) => <li>{pt}</li>)}</ul>}
  </div>
</a>
