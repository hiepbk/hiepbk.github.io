---
import type { CollectionEntry } from 'astro:content';

interface Props { pub: CollectionEntry<'publications'>['data'] }
const { pub } = Astro.props;
const me = ['Hiep Anh Hoang', 'Anh Hiep Hoang'];
const authors = pub.authors.split(',').map((a) => a.trim());
---
<article class:list={['pub', { 'has-thumb': pub.image }]}>
  {pub.image && <div class="pub-thumb"><img src={pub.image} alt={pub.title} loading="lazy" /></div>}
  <div class="pub-body">
    <span class="venue">{pub.venue_short}</span>
    <h3 class="pub-title">{pub.title}</h3>
    <p class="pub-authors">
      {authors.map((a, i) => (
        <>{me.includes(a) ? <strong>{a}</strong> : a}{i < authors.length - 1 && ', '}</>
      ))}
    </p>
    <p class="pub-venue">{pub.venue}, {pub.year}</p>
    {pub.note && <p class="pub-note">{pub.note}</p>}
    {pub.links.length > 0 && (
      <div class="pills">
        {pub.links.map((l) => <a class="pill" href={l.url} target="_blank" rel="noopener">{l.name}</a>)}
      </div>
    )}
  </div>
</article>
