---
// MV3D's region-based fusion, as data flowing through three small networks. The ROI-pooled features of one
// proposal (BEV, FV, RGB) enter on the left. Beat 1: early fusion (concatenate once, then one network).
// Beat 2: late fusion (three separate networks, concatenate at the end). Beat 3: deep fusion — an element-wise
// mean after every layer, and every branch reads the joined feature (Eq. 6 of the paper). Beat 4: drop-path
// during training — global (keep one random view) or local (drop each input of a join with probability 0.5).
// A schematic: no network is run, the dots only show which features each layer can see.
---
<canvas class="wt-canvas deep-fusion-canvas"
  role="img" aria-label="Three region features from the bird's-eye view, the front view and the image flow through early fusion (joined once at the input), late fusion (joined once at the end) and deep fusion (averaged after every layer, every branch reading the joint feature); drop-path then removes random inputs of the joins during training"></canvas>

<script>
  import { FIGURE_SPEED } from '../../../lib/figureClock';
  import { drawBlock, iconPalette } from '../../../lib/figureIcons';

  const L = 3; // layers drawn (the paper's head has fc6, fc7, fc8)
  const VIEWS = ['BEV', 'FV', 'RGB'];
  const HEADLINE = [
    'Early fusion: join the three views once, at the input',
    'Late fusion: three separate networks, joined only at the end',
    'Deep fusion: average after every layer, every branch reads the joint feature',
    'Training: drop-path removes random inputs of the joins',
  ];
  const HEADLINE_SHORT = ['Early fusion: join once, at the input', 'Late fusion: join once, at the end', 'Deep fusion: join after every layer', 'Training: drop-path'];
  const MODE = ['Early fusion', 'Late fusion', 'Deep fusion', 'Deep fusion + drop-path'];
  const NOTE = ['1 join (concatenation)', '1 join (concatenation)', `${L + 1} joins (element-wise mean)`, ''];

  // Stages along x: input · J0 · H1 · J1 · H2 · J2 · H3 · J3 · output. Rows: 0 = BEV, 1 = FV, 2 = RGB, 1 also = the single middle path.
  type Node = { s: number; r: number; kind: 'in' | 'H' | 'J' | 'out'; label: string; view?: number };
  type Edge = { a: Node; b: Node; view: number }; // view −1 = joint feature
  const graph = (mode: number) => {
    const nodes: Node[] = [], edges: Edge[] = [];
    const add = (n: Node) => (nodes.push(n), n);
    const ins = VIEWS.map((v, i) => add({ s: 0, r: i, kind: 'in', label: `f${v}`, view: i }));
    const out = add({ s: 2 * L + 2, r: 1, kind: 'out', label: 'out' });
    if (mode === 0) {
      let prev: Node = add({ s: 1, r: 1, kind: 'J', label: 'C' });
      ins.forEach((n, i) => edges.push({ a: n, b: prev, view: i }));
      for (let l = 1; l <= L; l++) { const h = add({ s: 2 * l, r: 1, kind: 'H', label: `H${l}` }); edges.push({ a: prev, b: h, view: -1 }); prev = h; }
      edges.push({ a: prev, b: out, view: -1 });
    } else if (mode === 1) {
      const j = add({ s: 2 * L + 1, r: 1, kind: 'J', label: 'C' });
      ins.forEach((n, i) => {
        let prev = n;
        for (let l = 1; l <= L; l++) { const h = add({ s: 2 * l, r: i, kind: 'H', label: `H${l}`, view: i }); edges.push({ a: prev, b: h, view: i }); prev = h; }
        edges.push({ a: prev, b: j, view: i });
      });
      edges.push({ a: j, b: out, view: -1 });
    } else {
      let j = add({ s: 1, r: 1, kind: 'J', label: 'M' });
      ins.forEach((n, i) => edges.push({ a: n, b: j, view: i }));
      for (let l = 1; l <= L; l++) {
        const jn = add({ s: 2 * l + 1, r: 1, kind: 'J', label: 'M' });
        VIEWS.forEach((_, i) => {
          const h = add({ s: 2 * l, r: i, kind: 'H', label: `H${l}`, view: i });
          edges.push({ a: j, b: h, view: -1 }, { a: h, b: jn, view: i });
        });
        j = jn;
      }
      edges.push({ a: j, b: out, view: -1 });
    }
    return { nodes, edges };
  };
  const GRAPHS = [0, 1, 2, 2].map(graph);

  document.querySelectorAll<HTMLCanvasElement>('.deep-fusion-canvas').forEach((canvas) => {
    const ctx = canvas.getContext('2d')!;

    // Beats: early · late · deep · drop-path (two draws: global, then local)
    const T = { early: 0, late: 6.5, deep: 13, drop: 21, end: 30 };
    const BEATS = [T.early, T.late, T.deep, T.drop];
    const STEP = 0.55; // seconds per stage for the flowing dots
    const ramp = (t: number, a: number, b: number) => Math.min(1, Math.max(0, (t - a) / (b - a)));
    const ease = (x: number) => x * x * (3 - 2 * x);
    // Drop-path draws: 0 = global (keep only view 1 = FV), 1 = local (inputs dropped at random, ≥ 1 kept per join)
    const LOCAL_DROP: Record<string, boolean> = { '1-0': true, '3-2': true, '5-1': true, '5-0': true, '7-2': true };

    let W = 0, H = 0;
    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = canvas.clientWidth; H = canvas.clientHeight;
      canvas.width = W * dpr; canvas.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    function frame(time: number) {
      const t = time % T.end;
      const css = getComputedStyle(document.documentElement);
      const text = css.getPropertyValue('--muted').trim() || '#555';
      const faint = css.getPropertyValue('--faint').trim() || '#999';
      const heading = css.getPropertyValue('--heading').trim() || '#34496f';
      const accent = css.getPropertyValue('--accent-2').trim() || '#7c3aed';
      const surface = css.getPropertyValue('--surface').trim() || '#fff';
      const dark = css.getPropertyValue('color-scheme').includes('dark');
      const red = dark ? '#ff6b6b' : '#dc2626';
      const pal = iconPalette();
      const VC = dark ? ['#3fd6cc', '#fbbf24', '#f472b6'] : ['#0d9488', '#d97706', '#db2777'];
      ctx.clearRect(0, 0, W, H);

      const beat = t < T.late ? 0 : t < T.deep ? 1 : t < T.drop ? 2 : 3;
      const bt = t - BEATS[beat];
      const fadeAll = 1 - ramp(t, T.end - 0.5, T.end);
      const fadeIn = ease(ramp(bt, 0, 0.5));
      const narrow = W < 520;
      const { nodes, edges } = GRAPHS[beat];
      const draw = beat === 3 ? (bt < 4.5 ? 0 : 1) : -1; // drop-path draw
      const dropped = (e: Edge) => {
        if (draw < 0 || e.b.kind !== 'J') return false;
        if (draw === 0) return e.view !== 1 && e.a.kind !== 'J'; // global: only the FV path survives
        return !!LOCAL_DROP[`${e.b.s}-${e.view}`];
      };

      // Layout
      const top = narrow ? 84 : 94;
      const x0 = narrow ? 34 : 84, x1 = W - (narrow ? 24 : 52);
      const sx = (s: number) => x0 + ((x1 - x0) * s) / (2 * L + 2);
      const rowGap = Math.min(narrow ? 56 : 74, (H - top - 40) / 2);
      const ry = (r: number) => top + 24 + r * rowGap;
      const pos = (n: Node) => [sx(n.s), ry(n.r)] as const;

      // Headline, titles, status lines
      ctx.globalAlpha = fadeAll * ease(ramp(bt, 0.05, 0.45));
      ctx.textAlign = 'center';
      ctx.font = `600 ${narrow ? 12 : 15}px Sora, sans-serif`;
      ctx.fillStyle = red;
      ctx.fillText((narrow ? HEADLINE_SHORT : HEADLINE)[beat], W / 2, 16, W - 8);
      ctx.globalAlpha = fadeAll;
      ctx.font = `600 ${narrow ? 12 : 14}px Sora, sans-serif`;
      ctx.fillStyle = heading;
      ctx.fillText('ROI features', sx(0), 46, 2 * sx(0) - 4);
      ctx.fillText(MODE[beat], (sx(2) + x1) / 2, 46, x1 - sx(2) + 20);
      ctx.font = `500 ${narrow ? 10 : 12}px "IBM Plex Sans", sans-serif`;
      ctx.fillStyle = text;
      ctx.fillText(narrow ? 'per view' : 'one proposal', sx(0), 64, 2 * sx(0) - 4);
      ctx.fillStyle = beat === 0 ? text : accent;
      const note = beat < 3 ? NOTE[beat] : draw === 0 ? (narrow ? 'global: keep one view' : 'global: keep one random view (here FV)') : narrow ? 'local: drop inputs, p = 0.5' : 'local: drop each join input with p = 0.5';
      ctx.fillText(note, (sx(2) + x1) / 2, 64, x1 - sx(2) + 20);

      // Flowing dots: progress P in stages, restarting for each drop-path draw
      const flowT = beat === 3 ? (draw === 0 ? bt : bt - 4.5) : bt;
      const P = (flowT - 0.7) / STEP;

      // Edges
      for (const e of edges) {
        const [ax0, ay] = pos(e.a), [bx, by] = pos(e.b);
        const ax = ax0 + (e.a.kind === 'in' ? (narrow ? 10 : 16) : 0); // start at the right end of the input vector
        const col = e.view < 0 ? heading : VC[e.view];
        const lit = P >= e.a.s;
        const off = dropped(e);
        ctx.globalAlpha = fadeAll * fadeIn * (off ? 0.35 : lit ? 0.9 : 0.3);
        ctx.strokeStyle = off ? faint : col;
        ctx.lineWidth = lit && !off ? 1.8 : 1;
        if (off) ctx.setLineDash([3, 4]);
        const mx = (ax + bx) / 2;
        ctx.beginPath(); ctx.moveTo(ax, ay); ctx.bezierCurveTo(mx, ay, mx, by, bx, by); ctx.stroke();
        ctx.setLineDash([]);
        if (off) {
          // A small cross on the dropped input
          const cx = ax + (bx - ax) * 0.7, cy = ay + (by - ay) * 0.7 + (by - ay) * 0.08;
          ctx.globalAlpha = fadeAll * fadeIn;
          ctx.strokeStyle = red;
          ctx.lineWidth = 1.6;
          ctx.beginPath(); ctx.moveTo(cx - 4, cy - 4); ctx.lineTo(cx + 4, cy + 4); ctx.moveTo(cx + 4, cy - 4); ctx.lineTo(cx - 4, cy + 4); ctx.stroke();
          continue;
        }
        const f = (P - e.a.s) / (e.b.s - e.a.s);
        if (f > 0 && f < 1) {
          // Dot on the Bézier curve
          const u = f, v = 1 - u;
          const x = v * v * v * ax + 3 * v * v * u * mx + 3 * v * u * u * mx + u * u * u * bx;
          const y = v * v * v * ay + 3 * v * v * u * ay + 3 * v * u * u * by + u * u * u * by;
          ctx.globalAlpha = fadeAll;
          ctx.fillStyle = col;
          ctx.beginPath(); ctx.arc(x, y, narrow ? 3 : 4, 0, 2 * Math.PI); ctx.fill();
        }
      }

      // Nodes
      for (const n of nodes) {
        const [x, y] = pos(n);
        const lit = P >= n.s - 0.02;
        ctx.globalAlpha = fadeAll * fadeIn;
        const col = n.view !== undefined ? VC[n.view] : heading;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        if (n.kind === 'in') {
          // Input feature: a short vector of cells in the view's colour
          const cw = narrow ? 5 : 8, ch = narrow ? 14 : 18;
          for (let k = 0; k < 4; k++) {
            ctx.fillStyle = col;
            ctx.globalAlpha = fadeAll * fadeIn * (0.45 + 0.15 * k);
            ctx.fillRect(x - 2 * cw + k * cw, y - ch / 2, cw - 1, ch);
          }
          ctx.globalAlpha = fadeAll * fadeIn;
          ctx.fillStyle = col;
          ctx.font = `600 ${narrow ? 9 : 12}px "IBM Plex Sans", sans-serif`;
          ctx.textAlign = 'right';
          ctx.fillText(VIEWS[n.view!], x - 2 * cw - 5, y);
        } else if (n.kind === 'H') {
          // A fully connected layer of this view's branch, drawn as an MLP block with its name inside the label
          const bw = narrow ? 30 : 46, bh = narrow ? 24 : 32;
          drawBlock(ctx, 'mlp', x - bw / 2, y - bh / 2, bw, bh, pal, { active: lit ? 0.6 : 0, alpha: fadeAll * fadeIn * (lit ? 1 : 0.5), compact: narrow });
          ctx.globalAlpha = fadeAll * fadeIn;
          ctx.fillStyle = lit ? col : faint;
          ctx.font = `italic 600 ${narrow ? 9 : 11}px "IBM Plex Sans", sans-serif`;
          ctx.fillText(n.label, x, y + bh / 2 + (narrow ? 8 : 10));
        } else if (n.kind === 'J' && n.label === 'C') {
          const bw = narrow ? 22 : 30, bh = narrow ? 20 : 26;
          drawBlock(ctx, 'concat', x - bw / 2, y - bh / 2, bw, bh, pal, { active: lit ? 0.6 : 0, alpha: fadeAll * fadeIn * (lit ? 1 : 0.5) });
        } else if (n.kind === 'J') {
          const rr = narrow ? 9 : 13;
          ctx.fillStyle = lit ? (n.label === 'M' ? accent : heading) : surface;
          ctx.beginPath(); ctx.arc(x, y, rr, 0, 2 * Math.PI); ctx.fill();
          ctx.strokeStyle = lit ? 'transparent' : faint;
          ctx.lineWidth = 1;
          ctx.stroke();
          ctx.fillStyle = lit ? '#fff' : faint;
          ctx.font = `600 ${narrow ? 10 : 13}px "IBM Plex Sans", sans-serif`;
          ctx.fillText(n.label === 'M' ? 'μ' : 'C', x, y + 0.5);
        } else {
          ctx.fillStyle = lit ? heading : faint;
          ctx.font = `600 ${narrow ? 9 : 12}px "IBM Plex Sans", sans-serif`;
          ctx.textAlign = 'left';
          ctx.fillText(narrow ? 'out' : 'class', x + 4, y - 8);
          if (!narrow) ctx.fillText('+ box', x + 4, y + 8);
          ctx.beginPath(); ctx.arc(x, y, 3, 0, 2 * Math.PI); ctx.fill();
        }
        ctx.textBaseline = 'alphabetic';
      }

      // Legend: join symbols
      ctx.globalAlpha = fadeAll;
      ctx.font = `500 ${narrow ? 9 : 11}px "IBM Plex Sans", sans-serif`;
      ctx.fillStyle = faint;
      ctx.textAlign = 'center';
      ctx.fillText(narrow ? '‖ = concat · μ = mean · H = FC layer' : '‖ = concatenation · μ = element-wise mean · H = fully connected layer', W / 2, H - 8, W - 8);
      ctx.globalAlpha = 1;
    }

    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    resize();
    window.addEventListener('resize', () => { resize(); if (still) frame(T.drop - 1); });
    if (still) { frame(T.drop - 1); return; }
    // The loop starts at beat 1 when the figure first scrolls into view
    let visible = false, raf: number | null = null, t0: number | null = null;
    const loop = (ms: number) => {
      t0 ??= ms;
      frame(((ms - t0) / 1000) * FIGURE_SPEED);
      raf = visible ? requestAnimationFrame(loop) : null;
    };
    new IntersectionObserver((entries) => {
      visible = entries[0].isIntersecting;
      if (visible && raf === null) raf = requestAnimationFrame(loop);
    }).observe(canvas);
  });
</script>
