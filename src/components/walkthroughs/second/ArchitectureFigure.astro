---
// SECOND's main architecture (after Fig. 1 of the paper: voxel feature extractor → sparse conv layers → RPN), large car model.
// One stage per row of the tensor-shape table in the article (same names and shapes), grouped like the paper's figure.
---
<canvas class="wt-canvas second-arch-canvas"
  role="img" aria-label="SECOND stage by stage, one stage per row of the shape table: voxelization and a voxel feature extractor, a sparse tensor, the sparse middle extractor, a dense bird's-eye-view map, three RPN stages, upsampling and concatenation, and the class, box and direction heads"></canvas>

<style>
  canvas.wt-canvas.second-arch-canvas { height: 430px; }
  @media (max-width: 600px) { canvas.wt-canvas.second-arch-canvas { height: 300px; } }
</style>

<script>
  import { runPipeline, type PipeSpec } from '../../../lib/walkthroughFiguresAClient';

  const SPEC: PipeSpec = {
  "cols": 6,
  "rows": 3,
  "nodes": [
    {
      "id": "in",
      "col": 0,
      "row": 0,
      "step": 0,
      "kind": "points",
      "label": "Input",
      "sub": "n×4"
    },
    {
      "id": "vox",
      "col": 1,
      "row": 0,
      "step": 1,
      "kind": "voxels",
      "label": "Voxelization",
      "sub": "5k–8k voxels"
    },
    {
      "id": "vfe",
      "col": 2,
      "row": 0,
      "step": 2,
      "kind": [
        "mlp",
        "maxpool",
        "concat"
      ],
      "label": "VFE ×2 + Linear",
      "sub": "128 per voxel",
      "shared": true
    },
    {
      "id": "sp",
      "col": 3,
      "row": 0,
      "step": 3,
      "kind": "voxels",
      "label": "Sparse tensor",
      "sub": "128×10×400×352"
    },
    {
      "id": "mid",
      "col": 0,
      "row": 1,
      "step": 4,
      "kind": "backbone",
      "label": "Sparse middle extractor",
      "sub": "64×2×400×352"
    },
    {
      "id": "dn",
      "col": 1,
      "row": 1,
      "step": 5,
      "kind": "map",
      "label": "To dense, reshape",
      "sub": "128×400×352"
    },
    {
      "id": "s1",
      "col": 0,
      "row": 2,
      "step": 6,
      "kind": "conv2d",
      "label": "RPN stage 1",
      "sub": "128×200×176"
    },
    {
      "id": "s2",
      "col": 1,
      "row": 2,
      "step": 7,
      "kind": "conv2d",
      "label": "RPN stage 2",
      "sub": "128×100×88"
    },
    {
      "id": "s3",
      "col": 2,
      "row": 2,
      "step": 8,
      "kind": "conv2d",
      "label": "RPN stage 3",
      "sub": "256×50×44"
    },
    {
      "id": "up",
      "col": 3,
      "row": 2,
      "step": 9,
      "kind": [
        "conv2d",
        "concat"
      ],
      "label": "Upsample + concat",
      "sub": "384×200×176"
    },
    {
      "id": "hd",
      "col": 4,
      "row": 2,
      "step": 10,
      "kind": "conv2d",
      "label": "Heads",
      "sub": "cls · box · dir"
    },
    {
      "id": "out",
      "col": 5,
      "row": 2,
      "step": 11,
      "kind": "boxes",
      "label": "3D boxes",
      "sub": "oriented"
    }
  ],
  "edges": [
    [
      "in",
      "vox"
    ],
    [
      "vox",
      "vfe"
    ],
    [
      "vfe",
      "sp"
    ],
    [
      "sp",
      "mid"
    ],
    [
      "mid",
      "dn"
    ],
    [
      "dn",
      "s1"
    ],
    [
      "s1",
      "s2"
    ],
    [
      "s2",
      "s3"
    ],
    [
      "s3",
      "up"
    ],
    [
      "up",
      "hd"
    ],
    [
      "hd",
      "out"
    ]
  ],
  "steps": [
    {
      "say": "Input: the raw LiDAR points",
      "short": "Input: raw points",
      "row": "Input",
      "shape": "n × 4 (x, y, z, r)"
    },
    {
      "say": "Voxelization with a hash table, as in VoxelNet",
      "short": "Voxelization (as VoxelNet)",
      "row": "Voxelization",
      "shape": "5k–8k non-empty voxels"
    },
    {
      "say": "Voxel feature extractor: VFE(32), VFE(128), Linear(128)",
      "short": "VFE ×2 + Linear",
      "row": "VFE(32), VFE(128), Linear(128)",
      "shape": "128 per voxel"
    },
    {
      "say": "The voxel features form a sparse tensor: only active sites are stored",
      "short": "Sparse tensor",
      "row": "Sparse tensor",
      "shape": "128 × 10 × 400 × 352 (sparse)"
    },
    {
      "say": "Sparse middle extractor: submanifold convs + one sparse conv per phase",
      "short": "Sparse middle extractor",
      "row": "Sparse middle extractor",
      "shape": "64 × 2 × 400 × 352"
    },
    {
      "say": "To dense, then merge the height into channels",
      "short": "To dense → BEV map",
      "row": "To dense, reshape",
      "shape": "128 × 400 × 352"
    },
    {
      "say": "RPN stage 1: 3 × Conv2D(128, 3), the first with stride 2",
      "short": "RPN stage 1",
      "row": "RPN stage 1",
      "shape": "128 × 200 × 176"
    },
    {
      "say": "RPN stage 2: 5 × Conv2D(128, 3), the first with stride 2",
      "short": "RPN stage 2",
      "row": "RPN stage 2",
      "shape": "128 × 100 × 88"
    },
    {
      "say": "RPN stage 3: 5 × Conv2D(256, 3), the first with stride 2",
      "short": "RPN stage 3",
      "row": "RPN stage 3",
      "shape": "256 × 50 × 44"
    },
    {
      "say": "Upsample each stage with DeConv2D(128, 3, s), s = 1, 2, 4, and concatenate",
      "short": "Upsample + concat",
      "row": "Upsample + concat",
      "shape": "384 × 200 × 176"
    },
    {
      "say": "Three 1 × 1 conv heads: class, box (7 per anchor), direction",
      "short": "Heads: class, box, direction",
      "row": "Heads",
      "shape": "class, box (7 per anchor), direction"
    },
    {
      "say": "Output: oriented 3D boxes, heading fixed by the direction head",
      "short": "Output: 3D boxes",
      "row": "Output (after the table)",
      "shape": "0.05 s per frame (large model)"
    }
  ],
  "groups": [
    {
      "label": "Voxel Feature Extractor",
      "col0": 0,
      "col1": 3,
      "row0": 0,
      "row1": 0,
      "steps": [
        0,
        1,
        2,
        3
      ]
    },
    {
      "label": "Sparse Convolutional Middle Extractor",
      "col0": 0,
      "col1": 1,
      "row0": 1,
      "row1": 1,
      "steps": [
        4,
        5
      ]
    },
    {
      "label": "Region Proposal Network",
      "col0": 0,
      "col1": 5,
      "row0": 2,
      "row1": 2,
      "steps": [
        6,
        7,
        8,
        9,
        10,
        11
      ]
    }
  ]
};

  document.querySelectorAll<HTMLCanvasElement>('.second-arch-canvas').forEach((canvas) => runPipeline(canvas, SPEC));
</script>
