---
// "Voxel Set Abstraction" on the real scan, top view. Beat 1: farthest point sampling picks the keypoints.
// Beat 2: one keypoint gathers the non-empty voxels of each sparse-CNN level (1×, 2×, 4×, 8× downsampled,
// KITTI voxel size 0.05 × 0.05 × 0.1 m) within two radii, then raw points and a bilinear lookup on the BEV map.
// Beat 3: the six results are concatenated into one keypoint feature. Beat 4: predicted keypoint weighting
// keeps foreground keypoints strong. Occupancy is computed here from the real points (a sparse conv output
// is approximated by the voxels that contain points at that resolution); voxels are shown projected to BEV.
import { cropScene, loadScene, fpsIndices } from '../../../lib/walkthroughFiguresB';

const X0 = -14, X1 = 16, Y0 = -7, Y1 = 11;
const r2 = (v: number) => Math.round(v * 100) / 100;
const pool = cropScene(X0, X1, Y0, Y1, 6000, { seed: 9 });
const disp = pool.slice(0, 1300).flatMap((p) => [Math.round(p[0] * 100), Math.round(p[1] * 100)]);
const kpIdx = fpsIndices(pool, 160, 3);
const keypoints = kpIdx.map((i) => [r2(pool[i][0]), r2(pool[i][1]), pool[i][4] >= 0 ? 1 : 0]);
// The keypoint we zoom on: the first FPS pick that lies on the best-observed car (box 2)
const focus = kpIdx.findIndex((i) => pool[i][4] === 2);
const kp = pool[kpIdx[focus]];

// Non-empty voxels around the keypoint at each level, in BEV relative to the keypoint: [dx, dy, inner]
const { pts } = loadScene();
const near = pts.filter((p) => Math.hypot(p[0] - kp[0], p[1] - kp[1], p[2] - kp[2]) < 5.5);
const LEVELS = [[0.4, 0.8], [0.8, 1.2], [1.2, 2.4], [2.4, 4.8]];
const levels = LEVELS.map(([ra, rb], k) => {
  const vs = 0.05 * 2 ** k, vz = 0.1 * 2 ** k;
  const cells = new Map<string, number[]>();
  for (const p of near) {
    const ix = Math.floor(p[0] / vs), iy = Math.floor(p[1] / vs), iz = Math.floor(p[2] / vz);
    const c = [(ix + 0.5) * vs, (iy + 0.5) * vs, (iz + 0.5) * vz];
    const d = Math.hypot(c[0] - kp[0], c[1] - kp[1], c[2] - kp[2]);
    if (d >= rb) continue;
    const key = `${ix},${iy}`; // one square per BEV column (inner wins)
    const inner = d < ra ? 1 : 0;
    if (!cells.has(key) || inner) cells.set(key, [r2(c[0] - kp[0]), r2(c[1] - kp[1]), inner]);
  }
  return { vs, r: [ra, rb], cells: [...cells.values()] };
});
// Raw points within (0.4, 0.8) m
const raw = near.filter((p) => Math.hypot(p[0] - kp[0], p[1] - kp[1], p[2] - kp[2]) < 0.8)
  .filter((_, k) => k % 2 === 0)
  .map((p) => [r2(p[0] - kp[0]), r2(p[1] - kp[1]), Math.hypot(p[0] - kp[0], p[1] - kp[1], p[2] - kp[2]) < 0.4 ? 1 : 0]);
// 8× BEV map (0.4 m cells) around the keypoint: occupied cells, and the 4 cells of the bilinear lookup
const bevCells = new Set<string>();
for (const p of near) if (Math.abs(p[0] - kp[0]) < 2 && Math.abs(p[1] - kp[1]) < 2) bevCells.add(`${Math.floor(p[0] / 0.4)},${Math.floor(p[1] / 0.4)}`);
const bev = [...bevCells].map((k) => k.split(',').map(Number)).map(([i, j]) => [r2((i + 0.5) * 0.4 - kp[0]), r2((j + 0.5) * 0.4 - kp[1])]);
// Bilinear lookup: the four cell centres around the keypoint
const bi = Math.floor(kp[0] / 0.4 - 0.5), bj = Math.floor(kp[1] / 0.4 - 0.5);
const bil = [[0, 0], [1, 0], [0, 1], [1, 1]].map(([a, b]) => [r2((bi + a + 0.5) * 0.4 - kp[0]), r2((bj + b + 0.5) * 0.4 - kp[1])]);
const data = { range: [X0, X1, Y0, Y1], disp, keypoints, focus, levels, raw, bev, bil };
---
<canvas class="wt-canvas vsa-canvas" data-vsa={JSON.stringify(data)}
  role="img" aria-label="Voxel set abstraction: farthest point sampling picks keypoints over the scan; one keypoint gathers the non-empty voxels within two radii at each of four sparse-CNN levels, plus raw points and the BEV map; the results are concatenated into one feature, and a predicted weight keeps foreground keypoints strong"></canvas>

<script>
  import { FIGURE_SPEED } from '../../../lib/figureClock';
  import { iconPalette, drawBlock } from '../../../lib/figureIcons';
  type Data = { range: number[]; disp: number[]; keypoints: number[][]; focus: number;
    levels: { vs: number; r: number[]; cells: number[][] }[]; raw: number[][]; bev: number[][]; bil: number[][] };

  const HEADLINE = [
    'Farthest point sampling spreads keypoints over the scan',
    'One keypoint gathers non-empty voxels at every level, two radii each',
    'Concatenate: one multi-scale feature per keypoint',
    'Predicted weighting: foreground keypoints count, background fades',
  ];
  const HEADLINE_SHORT = [
    'FPS spreads keypoints over the scan',
    'Each level: voxels within two radii',
    'Concatenate into one feature',
    'Foreground keypoints weigh more',
  ];
  const PANELS = ['level 1 (1×)', 'level 2 (2×)', 'level 3 (4×)', 'level 4 (8×)', 'raw points', 'BEV map'];
  const PANELS_SHORT = ['1×', '2×', '4×', '8×', 'raw', 'BEV'];
  const SEG = ['pv1', 'pv2', 'pv3', 'pv4', 'raw', 'bev'];

  document.querySelectorAll<HTMLCanvasElement>('.vsa-canvas').forEach((canvas) => {
    const d: Data = JSON.parse(canvas.dataset.vsa!);
    const ctx = canvas.getContext('2d')!;
    const [X0, X1, Y0, Y1] = d.range;
    const N = d.disp.length / 2, K = d.keypoints.length;
    const kp = d.keypoints[d.focus];

    // Beats: FPS · gather (six panels) · concatenate · weighting
    const T = { fps: 0, gather: 4.5, cat: 13.5, pkw: 17.5, end: 24 };
    const BEATS = [T.fps, T.gather, T.cat, T.pkw];
    const ramp = (t: number, a: number, b: number) => Math.min(1, Math.max(0, (t - a) / (b - a)));
    const ease = (x: number) => x * x * (3 - 2 * x);
    const pickAt = (k: number) => T.fps + 0.5 + (3.0 * k) / K;
    const panelAt = (j: number) => T.gather + 0.8 + j * 1.3;

    let W = 0, H = 0;
    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = canvas.clientWidth; H = canvas.clientHeight;
      canvas.width = W * dpr; canvas.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    function frame(time: number) {
      const t = time % T.end;
      const css = getComputedStyle(document.documentElement);
      const text = css.getPropertyValue('--muted').trim() || '#555';
      const faint = css.getPropertyValue('--faint').trim() || '#999';
      const heading = css.getPropertyValue('--heading').trim() || '#34496f';
      const accent = css.getPropertyValue('--accent-2').trim() || '#7c3aed';
      const dark = css.getPropertyValue('color-scheme').includes('dark');
      const red = dark ? '#ff6b6b' : '#dc2626';
      const orange = dark ? '#ffb86b' : '#d9730d';
      const neutral = dark ? '#5d6879' : '#b4bcc8';
      const hue = [200, 175, 140, 95, 28, 280];
      const segColor = (j: number, a = 1) => `hsl(${hue[j]} 70% ${dark ? 60 : 45}% / ${a})`;
      ctx.clearRect(0, 0, W, H);
      const pal = iconPalette();

      const beat = t < T.gather ? 0 : t < T.cat ? 1 : t < T.pkw ? 2 : 3;
      const fadeAll = 1 - ramp(t, T.end - 0.5, T.end);
      const pkw = beat === 3 ? ease(ramp(t, T.pkw + 0.6, T.pkw + 2.0)) : 0;

      // Layout: scene on the left; a 3 × 2 grid of zoom panels on the right; the feature bar under the grid
      const narrow = W < 520;
      const top = 80;
      const sceneW = narrow ? W * 0.4 : W * 0.44;
      const gx0 = sceneW + (narrow ? 8 : 26), gw = W - gx0 - 2;
      const barH = narrow ? 14 : 18, labH = narrow ? 12 : 15;
      const cellW = Math.min(gw / 3, (H - top - barH - 20) / 2 - labH);
      const pcs = cellW - (narrow ? 6 : 10); // panel size
      const gridW = cellW * 3, gxs = gx0 + (gw - gridW) / 2;
      const S = Math.min((sceneW - 4) / (X1 - X0), (H - top - 4) / (Y1 - Y0));
      const ox = (sceneW - S * (X1 - X0)) / 2, oy = top + (H - top - S * (Y1 - Y0)) / 2;
      const mx = (x: number) => ox + (x - X0) * S, my = (y: number) => oy + (Y1 - y) * S;

      // Headline, titles and status lines
      ctx.globalAlpha = fadeAll * ease(ramp(t, BEATS[beat] + 0.05, BEATS[beat] + 0.45));
      ctx.textAlign = 'center';
      ctx.font = `600 ${narrow ? 12 : 15}px Sora, sans-serif`;
      ctx.fillStyle = red;
      ctx.fillText((narrow ? HEADLINE_SHORT : HEADLINE)[beat], W / 2, 16, W - 8);
      ctx.globalAlpha = fadeAll;
      ctx.font = `600 ${narrow ? 12 : 14}px Sora, sans-serif`;
      ctx.fillStyle = heading;
      ctx.fillText(narrow ? 'Keypoints' : 'Scan with keypoints', sceneW / 2, 42);
      ctx.fillText(narrow ? 'One keypoint' : 'Around one keypoint', gxs + gridW / 2, 42);
      const picked = d.keypoints.filter((_, k) => t >= pickAt(k)).length;
      const lNote = [`${picked} keypoints (KITTI: 2,048)`, 'red ring: the keypoint', 'every keypoint, same steps', 'weight = foreground score'][beat];
      const lNoteS = [`${picked} keypoints`, 'red ring', 'all keypoints', 'weight = fg score'][beat];
      const rNote = ['4 voxel levels + raw points + BEV', 'shared MLP + max pool, radii grow per level', 'concatenate: f = [pv1, …, pv4, raw, bev]', 'PKW: 3-layer MLP → weight × feature'][beat];
      const rNoteS = ['6 sources', 'MLP + max, 2 radii', 'concatenate', 'MLP → weight'][beat];
      ctx.font = `500 ${narrow ? 10 : 12}px "IBM Plex Sans", sans-serif`;
      ctx.fillStyle = beat === 0 ? text : accent;
      ctx.fillText(narrow ? lNoteS : lNote, sceneW / 2, 60, sceneW);
      ctx.fillText(narrow ? rNoteS : rNote, gxs + gridW / 2, 60, gridW);

      const dot = (x: number, y: number, r: number, fill: string) => {
        ctx.fillStyle = fill;
        ctx.beginPath(); ctx.arc(x, y, r, 0, Math.PI * 2); ctx.fill();
      };
      const ring = (x: number, y: number, r: number, stroke: string, w = 1.4) => {
        ctx.strokeStyle = stroke; ctx.lineWidth = w;
        ctx.beginPath(); ctx.arc(x, y, r, 0, Math.PI * 2); ctx.stroke();
      };

      // Scene: raw points, then keypoints in FPS order; weighting enlarges foreground and fades background
      ctx.globalAlpha = fadeAll * ease(ramp(t, 0, 0.5)) * (1 - 0.4 * pkw);
      for (let i = 0; i < N; i++) dot(mx(d.disp[2 * i] / 100), my(d.disp[2 * i + 1] / 100), narrow ? 0.7 : 0.9, neutral);
      d.keypoints.forEach(([x, y, fg], k) => {
        if (t < pickAt(k)) return;
        const w = fg ? 1 : 1 - 0.75 * pkw;
        ctx.globalAlpha = fadeAll * w;
        dot(mx(x), my(y), (narrow ? 1.8 : 2.4) + (fg ? 1.4 * pkw : 0), fg && pkw > 0 ? orange : accent);
      });
      if (beat >= 1 && beat <= 2) {
        ctx.globalAlpha = fadeAll * ease(ramp(t, T.gather + 0.1, T.gather + 0.6));
        ring(mx(kp[0]), my(kp[1]), 7, red, 2);
      }

      // Zoom panels: one per source, each scaled so its outer radius fills the panel
      const panels = [
        ...d.levels.map((l) => ({ r: l.r, vs: l.vs, cells: l.cells, kind: 'vox' })),
        { r: [0.4, 0.8], vs: 0, cells: d.raw, kind: 'raw' },
        { r: [], vs: 0.4, cells: d.bev, kind: 'bev' },
      ];
      panels.forEach((p, j) => {
        const col = j % 3, row = Math.floor(j / 3);
        const x0 = gxs + col * cellW + (cellW - pcs) / 2, y0 = top + row * (pcs + labH + (narrow ? 6 : 8)) + labH;
        const cx = x0 + pcs / 2, cy = y0 + pcs / 2;
        const span = p.kind === 'bev' ? 4.0 : p.r[1] * 2.2; // metres across the panel
        const k = pcs / span;
        const on = beat >= 1 ? ease(ramp(t, panelAt(j), panelAt(j) + 0.6)) : 0;
        const active = beat === 1 && t >= panelAt(j) && t < panelAt(j + 1);
        // Label + frame
        ctx.globalAlpha = fadeAll * (beat === 0 ? 0.35 : 0.35 + 0.65 * on);
        ctx.font = `500 ${narrow ? 9 : 11}px "IBM Plex Sans", sans-serif`;
        ctx.fillStyle = active ? accent : text;
        ctx.textAlign = 'center';
        ctx.fillText((narrow ? PANELS_SHORT : PANELS)[j], cx, y0 - 4, cellW);
        ctx.strokeStyle = active ? accent : faint; ctx.lineWidth = active ? 1.5 : 1;
        ctx.strokeRect(x0, y0, pcs, pcs);
        if (on <= 0) return;
        ctx.save();
        ctx.beginPath(); ctx.rect(x0, y0, pcs, pcs); ctx.clip();
        if (p.kind === 'bev') {
          // 8× BEV map cells; the four cells of the bilinear lookup outlined
          const s = p.vs * k;
          for (const [dx, dy] of p.cells) {
            ctx.globalAlpha = fadeAll * on * 0.5;
            ctx.fillStyle = segColor(j, 0.6);
            ctx.fillRect(cx + dx * k - s / 2 + 0.5, cy - dy * k - s / 2 + 0.5, s - 1, s - 1);
          }
          ctx.globalAlpha = fadeAll * on;
          ctx.strokeStyle = segColor(j); ctx.lineWidth = 1.6;
          for (const [dx, dy] of d.bil) {
            ctx.strokeRect(cx + dx * k - s / 2 + 0.5, cy - dy * k - s / 2 + 0.5, s - 1, s - 1);
            ctx.beginPath(); ctx.moveTo(cx, cy); ctx.lineTo(cx + dx * k, cy - dy * k); ctx.stroke();
          }
        } else {
          const s = Math.max(1.5, p.vs * k);
          for (const [dx, dy, inner] of p.cells) {
            ctx.globalAlpha = fadeAll * on * (inner ? 0.95 : 0.45);
            ctx.fillStyle = segColor(j);
            if (p.kind === 'raw') dot(cx + dx * k, cy - dy * k, narrow ? 1.2 : 1.6, segColor(j));
            else ctx.fillRect(cx + dx * k - s / 2, cy - dy * k - s / 2, Math.max(1, s - (s > 4 ? 1 : 0)), Math.max(1, s - (s > 4 ? 1 : 0)));
          }
          ctx.globalAlpha = fadeAll * on * 0.9;
          ring(cx, cy, p.r[0] * k, faint, 1);
          ring(cx, cy, p.r[1] * k, faint, 1);
        }
        ctx.restore();
        ctx.globalAlpha = fadeAll * on;
        dot(cx, cy, 2.8, red);
        // Radii (wide layout)
        if (!narrow && p.r.length) {
          ctx.font = `500 10px "IBM Plex Mono", monospace`;
          ctx.fillStyle = faint;
          ctx.textAlign = 'right';
          ctx.fillText(`${p.r[0]}, ${p.r[1]} m`, x0 + pcs - 3, y0 + pcs - 4);
        }
      });

      // Feature bar: six segments filled as the panels are pooled, then concatenated (beat 3)
      const barY = top + 2 * (pcs + labH) + (narrow ? 12 : 18);
      const blkW = narrow ? 58 : 96, segW = (gridW - blkW) / 6;
      {
        // The learned layers of each step: shared MLP + max pool (gather), concatenation, weighting MLP
        const bh = barH + 10, by = barY - 5, x0b = gxs;
        const a1 = beat === 1 ? 1 : 0.4;
        if (beat <= 1) {
          const w2 = (blkW - 12) / 2;
          drawBlock(ctx, 'mlp', x0b, by, w2, bh, pal, { shared: true, active: beat === 1 ? 0.8 : 0, alpha: fadeAll * a1, compact: true });
          drawBlock(ctx, 'maxpool', x0b + w2 + 4, by, w2, bh, pal, { active: beat === 1 ? 0.8 : 0, alpha: fadeAll * a1, compact: true });
        } else if (beat === 2) {
          drawBlock(ctx, 'concat', x0b, by, blkW - 8, bh, pal, { active: ease(ramp(t, T.cat + 0.2, T.cat + 1.0)), alpha: fadeAll, compact: true });
        } else {
          drawBlock(ctx, 'mlp', x0b, by, blkW - 8, bh, pal, { shared: true, active: ease(ramp(t, T.pkw + 0.2, T.pkw + 1.0)), alpha: fadeAll, compact: true });
        }
      }
      SEG.forEach((name, j) => {
        const on = beat >= 1 ? ease(ramp(t, panelAt(j) + 0.6, panelAt(j) + 1.0)) : 0;
        const cat = beat >= 2 ? ease(ramp(t, T.cat + 0.3, T.cat + 1.3)) : 0;
        const gap = 4 * (1 - cat);
        ctx.globalAlpha = fadeAll * (0.25 + 0.75 * on) * (beat === 3 ? 1 - 0.0 * pkw : 1);
        ctx.fillStyle = on > 0 ? segColor(j, 0.85) : faint;
        ctx.fillRect(gxs + blkW + j * segW + gap / 2, barY, segW - gap, barH);
        ctx.globalAlpha = fadeAll * on;
        ctx.fillStyle = dark ? '#0b0f17' : '#ffffff';
        ctx.font = `600 ${narrow ? 8 : 10}px "IBM Plex Mono", monospace`;
        ctx.textAlign = 'center';
        ctx.fillText(name, gxs + blkW + j * segW + segW / 2, barY + barH / 2 + 3.5, segW - 2);
      });
      if (beat === 3) {
        ctx.globalAlpha = fadeAll * ease(ramp(t, T.pkw + 0.3, T.pkw + 0.9));
        ctx.strokeStyle = orange; ctx.lineWidth = 2;
        ctx.strokeRect(gxs + blkW - 2, barY - 2, gridW - blkW + 4, barH + 4);
      }
      ctx.globalAlpha = 1;
    }

    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    resize();
    window.addEventListener('resize', () => { resize(); if (still) frame(T.cat + 2); });
    if (still) { frame(T.cat + 2); return; }
    // The loop starts at beat 1 when the figure first scrolls into view
    let visible = false, raf: number | null = null, t0: number | null = null;
    const loop = (ms: number) => {
      t0 ??= ms;
      frame(((ms - t0) / 1000) * FIGURE_SPEED);
      raf = visible ? requestAnimationFrame(loop) : null;
    };
    new IntersectionObserver((entries) => {
      visible = entries[0].isIntersecting;
      if (visible && raf === null) raf = requestAnimationFrame(loop);
    }).observe(canvas);
  });
</script>
